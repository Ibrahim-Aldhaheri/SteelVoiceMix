[Unit]
Description=SteelVoiceMix GUI (ChatMix tray + overlay)
PartOf=graphical-session.target
After=graphical-session.target
# Crash-loop backstop. systemd's default limit is 5 starts per
# 10s, which RestartSec=3 can never reach — a deterministic
# crash would restart forever, spamming the journal and
# re-opening the device on every attempt. Widen the window so
# the limiter actually trips and the unit enters failed state.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/steelvoicemix-gui
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
